# Build output (CMake / MSBuild / CLion)
build/
cmake-build-*/
out/

# Compiler/linker artifacts
*.obj
*.o
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.exe
# Wyjatek: zaleznosci runtime paczki (H3.LodTable.dll z H3Plugins, licencja MIT,
# oraz TD.lod z grafikami przyciskow) - trzymane w repo, zeby projekt dalo sie
# odtworzyc bez istniejacej instalacji gry (deploy.ps1 bierze je stad).
!pack_assets/*.dll

# IDE
.idea/
.vs/

# Python (tools/)
__pycache__/
*.pyc

# Local Claude Code automation (personal, machine-specific)
.claude/

# Stare kopie danych kampanii sprzed przejscia na submodul tools/chronicles_voiceover/
